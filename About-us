<script>
var V = ["about", "faqs", "privacy", "disclaimer"];
function show(v){
  if(V.indexOf(v) < 0) v = "about";
  document.querySelectorAll("section").forEach(function(s){
    s.classList.toggle("on", s.id === v);
  });
  document.querySelectorAll("[data-v]").forEach(function(a){
    a.classList.toggle("on", a.getAttribute("data-v") === v);
  });
  window.scrollTo(0,0);
}
document.addEventListener("click", function(e){
  var a = e.target.closest("[data-v]");
  if(a){
    e.preventDefault();
    var target = a.getAttribute("data-v");
    location.hash = target;
    show(target);
  }
});
window.addEventListener("hashchange", function(){
  var hash = (location.hash || "").replace("#","");
  show(hash || "about");
});
var initial = (location.hash || "").replace("#","");
show(initial || "about");
</script>

